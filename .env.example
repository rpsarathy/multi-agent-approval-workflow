# ---- LLM ----
# mock  = deterministic, no network, no credentials (default)
# live  = Anthropic API (requires ANTHROPIC_API_KEY or an `ant auth login` profile)
# auto  = live when ANTHROPIC_API_KEY is set, otherwise mock
LLM_MODE=mock
ANTHROPIC_API_KEY=
# Only for API keys that are not scoped to a workspace (the API returns a 400 asking for it).
ANTHROPIC_WORKSPACE_ID=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_SERVER_FALLBACKS=true

# ---- Token budget ----
TOKEN_BUDGET_PER_RUN=40000
TOKEN_BUDGET_MAX_INPUT_PER_CALL=12000
TOKEN_BUDGET_MAX_OUTPUT_PER_CALL=8000
TOKEN_BUDGET_DAILY=500000

# ---- App ----
DATABASE_URL=sqlite:///./data/pa_orchestrator.db
# Secret from which each agent's internal-API credential is derived (>= 32 random chars).
# Empty = random per process; required when INTERNAL_API_BASE_URL is set.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_SECRET=
# Empty = agents call the internal API in-process over ASGI (no socket).
# Otherwise run `uvicorn app.internal_main:internal_app --port 8001` and set http://127.0.0.1:8001
INTERNAL_API_BASE_URL=
# Signs reviewer session tokens (>= 32 random chars). Empty = random per process.
REVIEWER_TOKEN_SECRET=
REVIEWER_TOKEN_TTL_SECONDS=28800
# Worker lease on a run (renewed by a heartbeat every third of this while busy). A RUNNING run
# whose lease expired was interrupted and becomes resumable.
RUN_LEASE_SECONDS=30
# Unsettled token reservations older than this (dead calls) are settled at their worst case on recovery.
TOKEN_RESERVATION_EXPIRY_SECONDS=900
